PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=office_attendance

# Chuỗi bí mật để ký JWT khi đăng nhập — một chuỗi ngẫu nhiên, dài, giữ bí mật.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Để trống = mỗi lần khởi động server dùng secret ngẫu nhiên tạm (chỉ dùng khi dev).
# KHÔNG dùng lại giá trị mẫu cũ "change-me-to-a-random-secret" — backend sẽ từ chối khởi động.
JWT_SECRET=

# (Tuỳ chọn) Chỉ cần khi frontend chạy ở origin KHÁC backend. Nhiều origin cách nhau bằng dấu phẩy.
# Mặc định không bật CORS (frontend gọi /api cùng origin qua nginx hoặc Vite proxy).
# CORS_ORIGIN=http://localhost:5173

# Quy tắc "Đi trễ": chấm công vào sau giờ bắt đầu + số phút châm chước thì tự được ghi là "Đi trễ".
# So sánh theo phút, theo giờ văn phòng. Mặc định: 08:00, châm chước 0 phút.
WORK_START_TIME=08:00
LATE_GRACE_MINUTES=0
# OFFICE_TZ=Asia/Ho_Chi_Minh
