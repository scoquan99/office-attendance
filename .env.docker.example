# Copy file này thành ".env" (cùng thư mục với docker-compose.yml) rồi chỉnh lại.
# JWT_SECRET là BẮT BUỘC — docker compose sẽ báo lỗi nếu thiếu.

POSTGRES_USER=postgres
# BẮT BUỘC: mật khẩu Postgres — docker compose sẽ báo lỗi nếu để trống.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
POSTGRES_PASSWORD=
POSTGRES_DB=office_attendance
POSTGRES_PORT=5432

BACKEND_PORT=4000
FRONTEND_PORT=8080

# BẮT BUỘC: một chuỗi ngẫu nhiên, dài, giữ bí mật. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# (Backend sẽ từ chối khởi động nếu dùng lại giá trị mẫu cũ "change-me-to-a-random-secret")
JWT_SECRET=

# Quy tắc "Đi trễ": chấm công vào sau giờ bắt đầu + số phút châm chước thì tự được ghi là "Đi trễ".
# So sánh theo phút, theo giờ văn phòng (OFFICE_TZ). Mặc định: 08:00, châm chước 0 phút.
WORK_START_TIME=08:00
LATE_GRACE_MINUTES=0
# OFFICE_TZ=Asia/Ho_Chi_Minh
