# Copy file này thành ".env" (cùng thư mục với docker-compose.yml) rồi chỉnh lại
# nếu muốn đổi mật khẩu DB / cổng / JWT secret. Không bắt buộc — nếu không tạo .env,
# docker-compose sẽ tự dùng các giá trị mặc định bên dưới.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=office_attendance
POSTGRES_PORT=5432

BACKEND_PORT=4000
FRONTEND_PORT=8080

# Đổi thành một chuỗi ngẫu nhiên, dài, giữ bí mật trước khi dùng thật
JWT_SECRET=change-me-to-a-random-secret
